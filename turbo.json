{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": ["TMPDIR"],
  "tasks": {
    "//#typecheck": {
      "outputs": []
    },
    "//#lint": {},
    "//#format:check": {},
    "//#boundaries": {},
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["^transit"],
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build", "^transit"],
      "outputs": ["dist/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
