# Copy to .env for local development. Never commit real values.
NODE_ENV=development
ROLE=all
PORT=3000
LOG_LEVEL=info

# Public origin of the API + web app (no trailing slash)
PUBLIC_URL=http://localhost:3000

# Postgres. Leave empty locally to use PGlite stored in ./.pglite
DATABASE_URL=
DATABASE_URL_DIRECT=
PGLITE_DIR=.pglite

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
# Owner account email. Secret: never commit the real value.
OWNER_EMAIL=owner@example.invalid

# Optional
SENTRY_DSN=
EXPO_ACCESS_TOKEN=

# M7 nightly archive
ARCHIVE_REPO=
ARCHIVE_GITHUB_TOKEN=
