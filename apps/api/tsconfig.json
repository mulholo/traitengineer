{
  "extends": "@te/config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": ".tsbuild",
    "rootDir": ".",
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "lib": ["es2023", "dom"]
  },
  "include": ["src", "test", "*.ts"],
  "references": [
    {
      "path": "../../packages/config"
    },
    {
      "path": "../../packages/contracts"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/db"
    },
    {
      "path": "../../packages/mcp"
    },
    {
      "path": "../../packages/client"
    }
  ]
}
