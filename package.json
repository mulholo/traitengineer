{
  "name": "traitengineer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "check": "turbo run test //#typecheck //#lint //#format:check //#boundaries",
    "check:full": "pnpm check && turbo run build && turbo run e2e",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "turbo run test",
    "build": "turbo run build",
    "gen:client": "pnpm --filter @te/api gen:openapi && pnpm --filter @te/client gen",
    "db:generate": "pnpm --filter @te/db generate",
    "db:migrate": "pnpm --filter @te/db migrate",
    "db:seed": "pnpm --filter @te/db seed",
    "user:create-owner": "pnpm --filter @te/api user:create-owner",
    "user:set-password": "pnpm --filter @te/api user:set-password",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "dependency-cruiser": "^18.6.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "turbo": "^2.11.8",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "pnpm@10.24.0"
}
